###############################
# FreeOpenVPN.Org config file #
# https://www.freeopenvpn.org #
###############################

setenv UV_ID 85ed224ebba04272811dd9f08c36972e
setenv UV_NAME winter-plateau-1947
client
dev tun
dev-type tun
remote de1.freeopenvpn.org 443 tcp-client
remote-random
nobind
persist-tun
cipher AES-128-CBC
auth SHA1
verb 2
mute 3
push-peer-info
ping 10
ping-restart 60
hand-window 70
server-poll-timeout 4
reneg-sec 2592000
sndbuf 393216
rcvbuf 393216
max-routes 1000
remote-cert-tls server
comp-lzo no
auth-user-pass /etc/openvpn/tunisia-sat.com-login.txt
key-direction 1
