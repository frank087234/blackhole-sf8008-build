# Config file by FreeVPN4You.net

ignore-unknown-option data-ciphers
setenv UV_ID b96483c2636c4cada2640958b050806b
setenv UV_NAME patient-fields-9326
client
dev tun
dev-type tun
remote be1.freevpn4you.online 443 tcp-client
nobind
persist-tun
cipher AES-128-CBC
data-ciphers AES-128-GCM:AES-128-CBC
auth SHA1
verb 2
mute 3
push-peer-info
ping 10
ping-restart 60
hand-window 70
server-poll-timeout 4
reneg-sec 2592000
sndbuf 393216
rcvbuf 393216
max-routes 1000
remote-cert-tls server
comp-lzo no
auth-user-pass /etc/openvpn/vpn-login.txt
key-direction 1
